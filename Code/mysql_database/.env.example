# Runtime
LOG_LEVEL=INFO
LOG_DIR=logs

# TCP transport
TCP_BIND_HOST=127.0.0.1
TCP_HOST=127.0.0.1
TCP_PORT=9000
TCP_CONTROL_MAX_BYTES=1048576
TCP_SOCKET_TIMEOUT_SECONDS=15
TCP_FILE_CHUNK_BYTES=65536

# Runtime storage
UPLOAD_DIR=uploads

# Giới hạn client queue; đây là cấu hình kỹ thuật, không liên quan số thành viên.
MAX_CONCURRENT_UPLOADS=3
# Các giới hạn validation này vẫn chưa được xác nhận.
MAX_FILE_SIZE_MB=
ALLOWED_EXTENSIONS=

# History: MySQL khi bật, JSON khi tắt.
MYSQL_ENABLED=false
HISTORY_JSON_PATH=database/history.json

# Không commit thông tin thật. Chỉ điền trong file .env cục bộ.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=udm_10
MYSQL_USER=
MYSQL_PASSWORD=
