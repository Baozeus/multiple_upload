        <mxCell id="e6" value="recv header" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4A6478;" edge="1" parent="1" source="listener" target="server_validation">
          <mxGeometry relative="1" as="geometry" />
