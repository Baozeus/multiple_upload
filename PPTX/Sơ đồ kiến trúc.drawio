        </mxCell>
        <mxCell id="queue" value="&lt;b&gt;Queue / Worker&lt;/b&gt;" style="html=1;whiteSpace=wrap;strokeColor=#2563A7;fillColor=#EAF3FB;fontColor=#17324D;fontSize=16;rounded=1;arcSize=14;strokeWidth=2;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="410" y="110" width="270" height="62" as="geometry" />
        </mxCell>
        <mxCell id="queue_life" value="" style="html=1;whiteSpace=wrap;strokeColor=#2563A7;fillColor=#FFFFFF;fontColor=#17324D;fontSize=1;shape=line;dashed=1;dashPattern=6 6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="543" y="172" width="4" height="910" as="geometry" />
        </mxCell>
        <mxCell id="server" value="&lt;b&gt;TCP Server&lt;/b&gt;" style="html=1;whiteSpace=wrap;strokeColor=#2F7D4A;fillColor=#EAF6EE;fontColor=#17324D;fontSize=16;rounded=1;arcSize=14;strokeWidth=2;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="110" width="270" height="62" as="geometry" />
        </mxCell>
        <mxCell id="server_life" value="" style="html=1;whiteSpace=wrap;strokeColor=#2F7D4A;fillColor=#FFFFFF;fontColor=#17324D;fontSize=1;shape=line;dashed=1;dashPattern=6 6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="933" y="172" width="4" height="910" as="geometry" />
        </mxCell>
        <mxCell id="fs" value="&lt;b&gt;Filesystem&lt;/b&gt;" style="html=1;whiteSpace=wrap;strokeColor=#5B6975;fillColor=#F3F6F8;fontColor=#17324D;fontSize=16;rounded=1;arcSize=14;strokeWidth=2;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1190" y="110" width="270" height="62" as="geometry" />
        </mxCell>
        <mxCell id="fs_life" value="" style="html=1;whiteSpace=wrap;strokeColor=#5B6975;fillColor=#FFFFFF;fontColor=#17324D;fontSize=1;shape=line;dashed=1;dashPattern=6 6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1323" y="172" width="4" height="910" as="geometry" />
        </mxCell>
        <mxCell id="history" value="&lt;b&gt;JSON History&lt;/b&gt;" style="html=1;whiteSpace=wrap;strokeColor=#5B6975;fillColor=#F3F6F8;fontColor=#17324D;fontSize=16;rounded=1;arcSize=14;strokeWidth=2;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1540" y="110" width="270" height="62" as="geometry" />
        </mxCell>
        <mxCell id="history_life" value="" style="html=1;whiteSpace=wrap;strokeColor=#5B6975;fillColor=#FFFFFF;fontColor=#17324D;fontSize=1;shape=line;dashed=1;dashPattern=6 6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1673" y="172" width="4" height="910" as="geometry" />
        </mxCell>
        <mxCell id="step1" value="1  Chọn / kéo thả nhiều file" style="html=1;whiteSpace=wrap;strokeColor=#2563A7;fillColor=#FFFFFF;fontColor=#17324D;fontSize=13;rounded=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="205" width="230" height="52" as="geometry" />
        </mxCell>
        <mxCell id="step2" value="2  Validate: tồn tại · đuôi · ≤500 KiB · tối đa 6 hợp lệ" style="html=1;whiteSpace=wrap;strokeColor=#2563A7;fillColor=#FFFFFF;fontColor=#17324D;fontSize=13;rounded=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="430" y="275" width="300" height="62" as="geometry" />
        </mxCell>
        <mxCell id="rejected" value="Không hợp lệ / vượt file thứ 6&lt;br&gt;&lt;b&gt;Từ chối, không tạo UploadItem&lt;/b&gt;" style="html=1;whiteSpace=wrap;strokeColor=#B53A3A;fillColor=#FDECEC;fontColor=#17324D;fontSize=12;rounded=1;arcSize=14;strokeWidth=2;dashed=1;dashPattern=5 4;" vertex="1" parent="1">
          <mxGeometry x="55" y="345" width="300" height="65" as="geometry" />
        </mxCell>
        <mxCell id="fifo" value="3  Tạo UploadItem → Chờ&lt;br&gt;FIFO cấp tối đa 3 slot" style="html=1;whiteSpace=wrap;strokeColor=#2563A7;fillColor=#FFFFFF;fontColor=#17324D;fontSize=13;rounded=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="430" y="425" width="300" height="62" as="geometry" />
        </mxCell>
        <mxCell id="connect" value="4  Worker chụp host:port&lt;br&gt;Mở 1 TCP connection / file" style="html=1;whiteSpace=wrap;strokeColor=#2563A7;fillColor=#FFFFFF;fontColor=#17324D;fontSize=13;rounded=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
