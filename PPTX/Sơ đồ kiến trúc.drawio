        <mxCell id="e4" value="header + binary payload" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4A6478;" edge="1" parent="1" source="workers" target="tcp_zone">
