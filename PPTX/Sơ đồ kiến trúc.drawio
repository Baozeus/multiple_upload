  <diagram name="1 - Tổng quan kiến trúc" id="udm10-page-1">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;UDM_10 — TỔNG QUAN KIẾN TRÚC&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5B6975&quot;&gt;Đường chạy mặc định: PySide6 Client → TCP Socket Server → Filesystem&lt;/font&gt;" style="html=1;whiteSpace=wrap;strokeColor=#FFFFFF;fillColor=#FFFFFF;fontColor=#17324D;fontSize=24;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1720" height="65" as="geometry" />
        </mxCell>
        <mxCell id="client_zone" value="&lt;b&gt;PROCESS CLIENT DESKTOP&lt;/b&gt;&lt;br&gt;Python 3 + PySide6" style="html=1;whiteSpace=wrap;strokeColor=#2563A7;fillColor=#EAF3FB;fontColor=#17324D;fontSize=18;rounded=1;arcSize=12;strokeWidth=2;verticalAlign=top;spacingTop=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="650" height="750" as="geometry" />
        </mxCell>
        <mxCell id="server_zone" value="&lt;b&gt;PROCESS SERVER&lt;/b&gt;&lt;br&gt;Python TCP Socket" style="html=1;whiteSpace=wrap;strokeColor=#2F7D4A;fillColor=#EAF6EE;fontColor=#17324D;fontSize=18;rounded=1;arcSize=12;strokeWidth=2;verticalAlign=top;spacingTop=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="990" y="110" width="760" height="750" as="geometry" />
        </mxCell>
        <mxCell id="tcp_zone" value="&lt;b&gt;TCP&lt;/b&gt;&lt;br&gt;1 kết nối riêng / file" style="html=1;whiteSpace=wrap;strokeColor=#17324D;fillColor=#FFFFFF;fontColor=#17324D;fontSize=17;ellipse;strokeWidth=3;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="725" y="285" width="225" height="250" as="geometry" />
        </mxCell>
        <mxCell id="gui" value="&lt;b&gt;PySide6 GUI&lt;/b&gt;&lt;br&gt;Chọn / kéo thả file&lt;br&gt;Bảng tác vụ · tiến độ · tốc độ · trạng thái" style="html=1;whiteSpace=wrap;strokeColor=#2563A7;fillColor=#FFFFFF;fontColor=#17324D;fontSize=14;rounded=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="180" width="270" height="125" as="geometry" />
        </mxCell>
        <mxCell id="validation" value="&lt;b&gt;Validation phía Client&lt;/b&gt;&lt;br&gt;Định dạng · dung lượng · tối đa 6 file hợp lệ/lần" style="html=1;whiteSpace=wrap;strokeColor=#2563A7;fillColor=#FFFFFF;fontColor=#17324D;fontSize=14;rounded=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="390" y="180" width="250" height="125" as="geometry" />
        </mxCell>
        <mxCell id="queue" value="&lt;b&gt;FIFO UploadQueue&lt;/b&gt;&lt;br&gt;Tối đa 3 item ở trạng thái Đang tải&lt;br&gt;Item còn lại: Chờ" style="html=1;whiteSpace=wrap;strokeColor=#2563A7;fillColor=#FFFFFF;fontColor=#17324D;fontSize=14;rounded=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="355" width="270" height="125" as="geometry" />
        </mxCell>
        <mxCell id="workers" value="&lt;b&gt;Worker TCP&lt;/b&gt;&lt;br&gt;thread nền / file&lt;br&gt;Signal/slot cập nhật GUI" style="html=1;whiteSpace=wrap;strokeColor=#2563A7;fillColor=#FFFFFF;fontColor=#17324D;fontSize=14;rounded=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="390" y="355" width="250" height="125" as="geometry" />
        </mxCell>
        <mxCell id="endpoint" value="&lt;b&gt;Endpoint cấu hình&lt;/b&gt;&lt;br&gt;IP / port 1–65535&lt;br&gt;Khóa khi còn Chờ hoặc Đang tải" style="html=1;whiteSpace=wrap;strokeColor=#2563A7;fillColor=#FFFFFF;fontColor=#17324D;fontSize=14;rounded=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="535" width="270" height="115" as="geometry" />
        </mxCell>
        <mxCell id="health" value="&lt;b&gt;Kiểm tra kết nối&lt;/b&gt;&lt;br&gt;health_check → HEALTHY&lt;br&gt;Không dùng slot upload" style="html=1;whiteSpace=wrap;strokeColor=#2563A7;fillColor=#FFFFFF;fontColor=#17324D;fontSize=14;rounded=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="390" y="535" width="250" height="115" as="geometry" />
        </mxCell>
        <mxCell id="history" value="&lt;b&gt;Lịch sử JSON cục bộ&lt;/b&gt;&lt;br&gt;%LOCALAPPDATA%/UDM_10/upload_history.json&lt;br&gt;Ghi kết quả terminal" style="html=1;whiteSpace=wrap;strokeColor=#5B6975;fillColor=#F3F6F8;fontColor=#17324D;fontSize=13;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="80" y="705" width="560" height="105" as="geometry" />
        </mxCell>
        <mxCell id="listener" value="&lt;b&gt;TCP Listener&lt;/b&gt;&lt;br&gt;bind host/port · listen(32)&lt;br&gt;1 thread / connection" style="html=1;whiteSpace=wrap;strokeColor=#2F7D4A;fillColor=#FFFFFF;fontColor=#17324D;fontSize=14;rounded=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1030" y="180" width="250" height="125" as="geometry" />
        </mxCell>
        <mxCell id="server_validation" value="&lt;b&gt;Protocol &amp; Validation&lt;/b&gt;&lt;br&gt;4-byte length + UTF-8 JSON&lt;br&gt;tên · đuôi · ≤ 512.000 byte" style="html=1;whiteSpace=wrap;strokeColor=#2F7D4A;fillColor=#FFFFFF;fontColor=#17324D;fontSize=14;rounded=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1330" y="180" width="370" height="125" as="geometry" />
        </mxCell>
        <mxCell id="semaphore" value="&lt;b&gt;BoundedSemaphore(3)&lt;/b&gt;&lt;br&gt;Hết slot → REJECTED&lt;br&gt;Thread kết nối ≠ upload đang hoạt động" style="html=1;whiteSpace=wrap;strokeColor=#2F7D4A;fillColor=#FFFFFF;fontColor=#17324D;fontSize=14;rounded=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1030" y="355" width="250" height="125" as="geometry" />
        </mxCell>
        <mxCell id="duplicate" value="&lt;b&gt;Reservation &amp; trùng tên&lt;/b&gt;&lt;br&gt;ask · rename · overwrite · skip&lt;br&gt;khóa đích chống race nội bộ" style="html=1;whiteSpace=wrap;strokeColor=#2F7D4A;fillColor=#FFFFFF;fontColor=#17324D;fontSize=14;rounded=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1330" y="355" width="370" height="125" as="geometry" />
        </mxCell>
        <mxCell id="write" value="&lt;b&gt;Lưu theo luồng&lt;/b&gt;&lt;br&gt;Server đọc 4 KiB/lần&lt;br&gt;ghi .udm10-upload-*.part" style="html=1;whiteSpace=wrap;strokeColor=#2F7D4A;fillColor=#FFFFFF;fontColor=#17324D;fontSize=14;rounded=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1030" y="535" width="250" height="115" as="geometry" />
        </mxCell>
        <mxCell id="commit" value="&lt;b&gt;Commit &amp; phản hồi&lt;/b&gt;&lt;br&gt;os.replace(file tạm, file đích)&lt;br&gt;SUCCESS {saved_as, bytes}" style="html=1;whiteSpace=wrap;strokeColor=#2F7D4A;fillColor=#FFFFFF;fontColor=#17324D;fontSize=14;rounded=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1330" y="535" width="370" height="115" as="geometry" />
        </mxCell>
        <mxCell id="filesystem" value="&lt;b&gt;FILESYSTEM&lt;/b&gt;&lt;br&gt;Mặc định: Code/uploads/ hoặc --dir&lt;br&gt;File vật lý, không lưu BLOB" style="html=1;whiteSpace=wrap;strokeColor=#5B6975;fillColor=#F3F6F8;fontColor=#17324D;fontSize=14;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="1030" y="705" width="360" height="105" as="geometry" />
        </mxCell>
        <mxCell id="mysql" value="&lt;b&gt;MySQL 8 module&lt;/b&gt;&lt;br&gt;Metadata/history tùy chọn&lt;br&gt;&lt;b&gt;Chưa nối runtime mặc định&lt;/b&gt;" style="html=1;whiteSpace=wrap;strokeColor=#7555A5;fillColor=#F1ECFA;fontColor=#17324D;fontSize=13;rounded=1;arcSize=14;strokeWidth=2;dashed=1;dashPattern=8 6;" vertex="1" parent="1">
          <mxGeometry x="1430" y="705" width="270" height="105" as="geometry" />
        </mxCell>
        <mxCell id="limits" value="&lt;b&gt;GIỚI HẠN ĐÃ XÁC MINH&lt;/b&gt;   6 file hợp lệ / lần thêm   ·   3 upload đồng thời   ·   500 KiB / file   ·   .txt  .pdf  .jpg  .jpeg  .doc  .docx" style="html=1;whiteSpace=wrap;strokeColor=#C06B20;fillColor=#FFF1E6;fontColor=#17324D;fontSize=15;rounded=1;arcSize=14;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="1710" height="70" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Chú giải&lt;/b&gt;  Nét liền: luồng chính / request   ·   Nét đứt: phản hồi hoặc module tùy chọn   ·   TCP là canonical; HTTP/mock chỉ là nhánh legacy cấu hình" style="html=1;whiteSpace=wrap;strokeColor=#5B6975;fillColor=#FFFFFF;fontColor=#17324D;fontSize=12;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="990" width="1710" height="45" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="đường dẫn file" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4A6478;" edge="1" parent="1" source="gui" target="validation">
          <mxGeometry relative="1" as="geometry" />
