        <mxCell id="e2" value="file hợp lệ" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4A6478;" edge="1" parent="1" source="validation" target="queue">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="cấp tối đa 3 slot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4A6478;" edge="1" parent="1" source="queue" target="workers">
          <mxGeometry relative="1" as="geometry" />
